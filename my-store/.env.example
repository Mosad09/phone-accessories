# Copy to `.env` locally (never commit `.env`).
# Vite only exposes variables prefixed with VITE_
# https://vitejs.dev/guide/env-and-mode.html

VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Optional: defaults to /api/analyze-product-image.
# In production, Firebase Hosting rewrites this path to the analyzeProductImage function.
VITE_AI_PRODUCT_INFO_URL=

# Server-side only. Set OPENAI_API_KEY as a Firebase Functions secret:
# firebase functions:secrets:set OPENAI_API_KEY
